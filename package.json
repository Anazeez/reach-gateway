{
  "name": "reach-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "check": "npm run build && npm run lint && node --test test/prerequisites.test.mjs && npm test",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "lint": "eslint eslint.config.mjs scripts test/prerequisites.test.mjs",
    "test": "vitest run",
    "test:live": "REACH_LIVE_TESTS=1 vitest run test/live-smoke.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "agents": "0.20.1",
    "fast-xml-parser": "5.10.1",
    "ipaddr.js": "2.4.0",
    "jose": "6.2.6",
    "linkedom": "0.18.13",
    "youtube-transcript": "1.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.118.0"
  }
}
